# Copy to .env (never commit .env). All values are optional for local dev.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to run in demo mode (templated sample briefs, clearly labelled in the UI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# auto = Claude if ANTHROPIC_API_KEY is set, otherwise demo. Or force "anthropic" / "demo".
BRIEF_GENERATOR=auto
BRIEF_RATE_LIMIT_PER_MIN=10
# Reverse proxies that append to X-Forwarded-For (0 = ignore the header).
TRUSTED_PROXY_COUNT=0
# Max LLM generations per day per worker process (spend guard for public demos).
BRIEF_DAILY_LIMIT=200
